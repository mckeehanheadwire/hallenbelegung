{
  "name": "hallenbelegung-muri",
  "private": true,
  "description": "Hallenbelegung Muri-Gümligen: static app on WREN + Cloudflare Worker for club requests",
  "scripts": {
    "dev": "wrangler dev --env dev --port 8787",
    "setup:wren": "node scripts/setup-wren-dev.mjs",
    "test": "node --test",
    "deploy:api": "wrangler deploy",
    "deploy:site": "bash deploy_site.sh",
    "publish:site": "bash deploy_site.sh --promote"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "wrangler": "^4.150.0"
  }
}
